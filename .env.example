# Copy to .env and adjust:  cp .env.example .env
# Used by docker-compose.yml. Everything except POSTGRES_PASSWORD is optional.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
# Any value works locally; use a long random string in production.
POSTGRES_PASSWORD=jadro-dev-password

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# development = readable logs; production = JSON logs + stricter warnings
APP_ENV=development
LOG_LEVEL=info

# Comma-separated CORS origins. Empty = allow any origin (fine locally; the
# site itself is same-origin behind nginx). Production: your site's origin(s).
# ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Schedules (cron syntax, evaluated in UTC unless noted)
# ---------------------------------------------------------------------------
INGEST_CRON=*/15 * * * *
# Fetch feeds immediately on startup instead of waiting for the first tick.
INGEST_ON_START=true
CLEANUP_CRON=0 3 * * *
# Articles older than this are deleted by the cleanup job.
CLEANUP_RETENTION_DAYS=3

# ---------------------------------------------------------------------------
# Embeddings (ONNX Runtime)
# ---------------------------------------------------------------------------
# Set to aarch64 on ARM machines (Apple Silicon, Graviton). `make models`
# prints the right value for your machine.
ORT_ARCH=x64

# ---------------------------------------------------------------------------
# Web Push (optional) — leave the keys empty to disable push entirely.
# Generate a keypair with `make vapid`.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Daily push, evaluated in PUSH_TIMEZONE
PUSH_CRON=0 9 * * *
PUSH_TIMEZONE=Europe/Skopje
PUSH_MIN_SOURCES=3
PUSH_FRESH_HOURS=16

# ---------------------------------------------------------------------------
# Optional third-party analytics
# ---------------------------------------------------------------------------
# Analytics are off by default. To enable Google Analytics 4, set
# VITE_GA_MEASUREMENT_ID in frontend/.env and allow its origins in the
# Content-Security-Policy (space-separated):
# CSP_SCRIPT_SRC=https://www.googletagmanager.com
# CSP_CONNECT_SRC=https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com
CSP_SCRIPT_SRC=
CSP_CONNECT_SRC=

# ---------------------------------------------------------------------------
# Networking — change only if something else already uses these
# ---------------------------------------------------------------------------
# Host ports (bound to 127.0.0.1 only)
# HTTP_PORT=8000
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# Docker network for the stack (must match set_real_ip_from in nginx/nginx.conf)
# DOCKER_SUBNET=172.18.0.0/16
