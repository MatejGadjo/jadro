# Only needed when running the backend outside Docker (`make dev-backend`).
# Copy to backend/.env. Postgres/Redis come from `make dev-deps`.

DATABASE_URL=postgres://news:jadro-dev-password@localhost:5432/newsaggregator?sslmode=disable
REDIS_URL=redis://localhost:6379
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
INGEST_ON_START=true

# Linux x64 host: the runtime downloaded by `make models`. Leave empty to run
# without embeddings (articles are ingested but not clustered).
ONNX_RUNTIME_LIB_PATH=./models/onnxruntime-linux-x64-1.23.2/lib/libonnxruntime.so
ONNX_MODEL_PATH=./models/paraphrase-multilingual-MiniLM-L12-v2/model.onnx
ONNX_TOKENIZER_PATH=./models/paraphrase-multilingual-MiniLM-L12-v2/tokenizer.json

# The Vite dev server calls the API cross-origin.
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXIES=127.0.0.1
