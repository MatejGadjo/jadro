# Environment / secrets — only *.example files are committed
.env
.env.*
!.env.example
.envrc

# Local overrides
docker-compose.override.yml
*.local.json

# Deployment-specific trusted proxy ranges (see nginx/real-ip.d/README.md)
nginx/real-ip.d/*.conf

# Personal AI tool settings (shared AGENTS.md / CLAUDE.md are committed)
.claude/
**/.claude/settings.local.json

# ML models and ONNX runtime — large binaries, fetched by `make models`
backend/models/

# Build output
backend/bin/
frontend/dist/
node_modules/
stats.html
coverage/
coverage.out
coverage.html

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local browser-automation artifacts
.playwright-mcp/
